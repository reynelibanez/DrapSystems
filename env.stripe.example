# ============================================
# EJEMPLO DE CONFIGURACIÓN DE STRIPE
# ============================================
# 
# INSTRUCCIONES:
# 1. Ve a https://dashboard.stripe.com/test/products
# 2. Crea los productos con los precios indicados abajo
# 3. Copia los Price IDs que Stripe te da
# 4. Reemplaza los valores en tu archivo .env
#
# ============================================

# Claves de API de Stripe (ya deberías tenerlas)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# PRICE IDs - PLANES MENSUALES
# ============================================

# Professional Plan - $29.00 USD/mes
# Crear en Stripe: Producto "Professional Plan" → Precio $29/month
# Copiar el Price ID y pegarlo aquí:
STRIPE_PRICE_PROFESSIONAL_MONTH=price_xxxxxxxxxxxxx

# Business Plan - $79.00 USD/mes  
# Crear en Stripe: Producto "Business Plan" → Precio $79/month
# Copiar el Price ID y pegarlo aquí:
STRIPE_PRICE_BUSINESS_MONTH=price_xxxxxxxxxxxxx

# Enterprise Plan - $199.00 USD/mes
# Crear en Stripe: Producto "Enterprise Plan" → Precio $199/month
# Copiar el Price ID y pegarlo aquí:
STRIPE_PRICE_ENTERPRISE_MONTH=price_xxxxxxxxxxxxx

# ============================================
# PRICE IDs - PLANES ANUALES (10% descuento)
# ============================================

# Professional Plan - $313.20 USD/año ($26.10/mes)
# En el mismo producto "Professional Plan" → Add another price → $313.20/year
# Copiar el Price ID y pegarlo aquí:
STRIPE_PRICE_PROFESSIONAL_YEAR=price_xxxxxxxxxxxxx

# Business Plan - $853.20 USD/año ($71.10/mes)
# En el mismo producto "Business Plan" → Add another price → $853.20/year
# Copiar el Price ID y pegarlo aquí:
STRIPE_PRICE_BUSINESS_YEAR=price_xxxxxxxxxxxxx

# Enterprise Plan - $2,149.20 USD/año ($179.10/mes)
# En el mismo producto "Enterprise Plan" → Add another price → $2,149.20/year
# Copiar el Price ID y pegarlo aquí:
STRIPE_PRICE_ENTERPRISE_YEAR=price_xxxxxxxxxxxxx

# ============================================
# COMPATIBILIDAD (opcional - para código legacy)
# ============================================
STRIPE_PRICE_PROFESSIONAL=price_xxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxx

# ============================================
# DESPUÉS DE CONFIGURAR:
# ============================================
# 1. Guarda el archivo .env
# 2. Ejecuta: npm run check-stripe
# 3. Ejecuta: npm run dev
# 4. Prueba seleccionar un plan
# ============================================
