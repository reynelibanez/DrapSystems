# ============================================
# STRIPE CONFIGURATION - PRICE IDS
# ============================================
# 
# INSTRUCCIONES:
# 1. Ve a https://dashboard.stripe.com/test/products
# 2. Crea los productos y precios según CONFIGURAR_PRICE_IDS.md
# 3. Copia los Price IDs de cada precio
# 4. Reemplaza los valores abajo
# 5. Copia estas líneas al archivo .env
# 6. Ejecuta: node verificar-price-ids.js
# 7. Reinicia el servidor: npm run dev
#
# ============================================

# PLAN PROFESSIONAL
# Precio mensual: $29.00 USD (recurring, monthly)
STRIPE_PRICE_PROFESSIONAL_MONTH=price_REEMPLAZAR_CON_TU_PRICE_ID

# Precio anual: $313.20 USD (recurring, yearly) - 10% descuento
STRIPE_PRICE_PROFESSIONAL_YEAR=price_REEMPLAZAR_CON_TU_PRICE_ID

# PLAN BUSINESS
# Precio mensual: $79.00 USD (recurring, monthly)
STRIPE_PRICE_BUSINESS_MONTH=price_REEMPLAZAR_CON_TU_PRICE_ID

# Precio anual: $853.20 USD (recurring, yearly) - 10% descuento
STRIPE_PRICE_BUSINESS_YEAR=price_REEMPLAZAR_CON_TU_PRICE_ID

# PLAN ENTERPRISE
# Precio mensual: $199.00 USD (recurring, monthly)
STRIPE_PRICE_ENTERPRISE_MONTH=price_REEMPLAZAR_CON_TU_PRICE_ID

# Precio anual: $2,149.20 USD (recurring, yearly) - 10% descuento
STRIPE_PRICE_ENTERPRISE_YEAR=price_REEMPLAZAR_CON_TU_PRICE_ID

# ============================================
# LEGACY PRICE IDS (mantener para compatibilidad)
# ============================================
# Estos pueden ser iguales a los precios mensuales
STRIPE_PRICE_PROFESSIONAL=price_REEMPLAZAR_CON_TU_PRICE_ID
STRIPE_PRICE_BUSINESS=price_REEMPLAZAR_CON_TU_PRICE_ID
STRIPE_PRICE_ENTERPRISE=price_REEMPLAZAR_CON_TU_PRICE_ID

# ============================================
# EJEMPLO DE CÓMO SE VE UN PRICE ID REAL:
# ============================================
# STRIPE_PRICE_PROFESSIONAL_MONTH=price_1QYZ123abc456DEF789
# STRIPE_PRICE_PROFESSIONAL_YEAR=price_1ABC456def789GHI012
#
# Los Price IDs:
# - Empiezan con "price_"
# - Tienen ~30 caracteres en total
# - Son alfanuméricos (letras y números)
# - Son diferentes en modo Test y Producción
# ============================================
