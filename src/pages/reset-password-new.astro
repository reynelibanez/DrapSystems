---
import MainLayout from '../layouts/main.astro';
import { ResetPasswordWrapper } from '../components/ResetPasswordWrapper';
import '../styles/global.css';

// Importar overrides solo en producción
if (import.meta.env.PROD) {
  await import('../styles/production-overrides.css');
}

// Extraer token de la URL en el servidor
const url = new URL(Astro.request.url);
const token = url.searchParams.get('token');

// Si no hay token, redirigir a forgot-password
if (!token) {
  return Astro.redirect('/forgot-password');
}

const pageClass = 'booking-app';
---

<MainLayout pageClass={pageClass}>
  <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-600 to-blue-600 p-4">
    <ResetPasswordWrapper token={token} client:only="react" />
    
    <noscript>
      <div style="padding: 2rem; text-align: center; background: white; border-radius: 8px; max-width: 500px;">
        <h2 style="color: #333; margin-bottom: 1rem;">JavaScript Required</h2>
        <p style="color: #666;">This application requires JavaScript to be enabled.</p>
        <p style="color: #666; margin-top: 1rem;">Please enable JavaScript in your browser and try again.</p>
      </div>
    </noscript>
  </div>
</MainLayout>

<style is:global>
  html.booking-app,
  html.booking-app body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    height: auto;
  }
</style>

