---
import MainLayout from '../layouts/main.astro';
import '../styles/global.css';

const pageClass = 'forgot-password-page';
---

<MainLayout pageClass={pageClass}>
  <div id="forgot-password-root"></div>
</MainLayout>

<script>
  import { createRoot } from 'react-dom/client';
  import { ForgotPasswordForm } from '../components/ForgotPasswordForm';
  import { baseUrl } from '../lib/base-url';
  import '../lib/i18n';

  const container = document.getElementById('forgot-password-root');
  if (container) {
    const root = createRoot(container);
    root.render(
      ForgotPasswordForm({
        onBack: () => {
          window.location.href = `${baseUrl}/`;
        }
      })
    );
  }
</script>

<style is:global>
  html.forgot-password-page,
  html.forgot-password-page body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  #forgot-password-root {
    width: 100%;
    max-width: 500px;
    padding: 1rem;
  }
</style>
