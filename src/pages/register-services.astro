
---
import MainLayout from '../layouts/main.astro';
import '../styles/global.css';

const pageClass = 'register-services-page';
---

<MainLayout pageClass={pageClass}>
  <div id="register-services-root">
    <div id="register-services-app"></div>
    <noscript>
      <div style="padding: 2rem; text-align: center;">
        <h1>JavaScript Required</h1>
        <p>This application requires JavaScript to be enabled.</p>
      </div>
    </noscript>
  </div>
</MainLayout>

<script>
  import { createRoot } from 'react-dom/client';
  import { RegisterServicesApp } from '../components/RegisterServicesApp';
  import { createElement } from 'react';

  const container = document.getElementById('register-services-app');
  if (container) {
    const root = createRoot(container);
    root.render(createElement(RegisterServicesApp));
  }
</script>

<style is:global>
  html.register-services-page,
  html.register-services-page body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    height: auto;
  }

  #register-services-root {
    min-height: 100vh;
    width: 100%;
    height: auto;
  }
</style>

