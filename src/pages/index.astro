



---
import MainLayout from '../layouts/main.astro';
import { AppRouter } from '../components/AppRouter';
import '../styles/global.css';

const pageClass = 'booking-app';
---

<MainLayout pageClass={pageClass}>
  <div id="app-root">
    <AppRouter client:only="react" />
    <noscript>
      <div style="padding: 2rem; text-align: center;">
        <h1>JavaScript Required</h1>
        <p>This application requires JavaScript to be enabled.</p>
      </div>
    </noscript>
  </div>
</MainLayout>

<style is:global>
  /* Importar overrides de producción */
  @import '../styles/production-overrides.css';

  html.booking-app,
  html.booking-app body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    height: auto;
  }

  #app-root {
    min-height: 100vh;
    width: 100%;
    height: auto;
  }
</style>





