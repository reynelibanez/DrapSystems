---
import MainLayout from '../layouts/main.astro';
import { ResetPasswordWrapper } from '../components/ResetPasswordWrapper';
import '../styles/global.css';

// Importar overrides solo en producción
if (import.meta.env.PROD) {
  await import('../styles/production-overrides.css');
}

const pageClass = 'booking-app';
---

<MainLayout pageClass={pageClass}>
  <div id="reset-password-root">
    <ResetPasswordWrapper client:only="react" />
    <noscript>
      <div style="padding: 2rem; text-align: center;">
        <h1>JavaScript Required</h1>
        <p>This application requires JavaScript to be enabled.</p>
      </div>
    </noscript>
  </div>
</MainLayout>

<style is:global>
  html.booking-app,
  html.booking-app body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    height: auto;
  }

  #reset-password-root {
    min-height: 100vh;
    width: 100%;
    height: auto;
  }
</style>

